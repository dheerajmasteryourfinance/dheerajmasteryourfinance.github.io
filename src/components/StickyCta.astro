---
// The early-access bar that appears once the visitor scrolls past the hero.
import type { Locale } from '../i18n/index.ts';
import { MOTION } from '../i18n/motion.ts';
import { APP_REGISTER } from '../lib/links.js';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = MOTION[locale];
---
<div class="stickycta" data-sticky-cta>
  <span>{t.sticky}</span>
  <a class="btn btn-accent" href={APP_REGISTER} rel="noopener noreferrer">{t.stickyCta}</a>
</div>
