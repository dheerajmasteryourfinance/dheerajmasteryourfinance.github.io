---
import LangSwitch from './LangSwitch.astro';
import { APP_LOGIN } from '../lib/links.js';
import { COMPANY, kvkLine, vatLine, addressLine } from '../lib/company.ts';
import { getLocale, localize } from '../i18n/index.ts';
import { UI } from '../i18n/ui.ts';
interface Props { switchPath: string }
const { switchPath } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = UI[locale].footer;
const signIn = UI[locale].nav.signIn;
const l = (p: string) => localize(p, locale);
const facts = [COMPANY.legalName, kvkLine(), vatLine(locale), addressLine()];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-cols">
      <div>
        <h2>{t.product}</h2>
        <ul>
          <li><a href={l('/features/')}>{t.features}</a></li>
          <li><a href={APP_LOGIN} rel="noopener noreferrer">{signIn}</a></li>
        </ul>
      </div>
      <div>
        <h2>{t.learn}</h2>
        <ul><li><a href={l('/docs/')}>{t.docs}</a></li></ul>
      </div>
      <div>
        <h2>{t.company}</h2>
        <ul>
          <li><a href={l('/company/')}>{t.about}</a></li>
          <li><a href={l('/company/#contact')}>{t.contact}</a></li>
          <li><a href={l('/email/')}>{t.emailFromUs}</a></li>
        </ul>
      </div>
      <div>
        <h2>{t.legal}</h2>
        <ul>
          <li><a href={l('/privacy/')}>{t.privacy}</a></li>
          <li><a href={l('/terms/')}>{t.terms}</a></li>
          <li><a href={l('/cookies/')}>{t.cookies}</a></li>
        </ul>
      </div>
    </div>
    <ul class="footer-trust" aria-label={t.trustLabel}>
      {t.trust.map((item) => (
        <li><svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg>{item}</li>
      ))}
    </ul>
    <div class="footer-legal">
      <ul class="footer-facts" aria-label={t.factsLabel}>
        {facts.map((f) => <li>{f}</li>)}
      </ul>
      <div class="footer-end">
        <LangSwitch path={switchPath} variant="long" />
        <p class="footer-made">{t.madeIn}</p>
      </div>
    </div>
  </div>
</footer>
