---
import { APP_LOGIN, APP_PLACEHOLDER } from '../lib/links.js';
import { COPY, COMPANY } from '../lib/copy.js';
const facts = [COMPANY.legalName, COMPANY.kvk, COMPANY.btw, COMPANY.address, COMPANY.phone];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-cols">
      <div>
        <h2>Product</h2>
        <ul>
          <li><a href="/features/">Features</a></li>
          <li><a href={APP_LOGIN} data-placeholder={APP_PLACEHOLDER} rel="noopener noreferrer">Sign in</a></li>
        </ul>
      </div>
      <div>
        <h2>Learn</h2>
        <ul><li><a href="/docs/">Docs</a></li></ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="/company/">About</a></li>
          <li><a href="/company/#contact">Contact</a></li>
          <li><a href="/email/">Email from us?</a></li>
        </ul>
      </div>
      <div>
        <h2>Legal</h2>
        <ul>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/cookies/">Cookies</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">
      <ul class="footer-facts" aria-label={COPY.footerFactsLabel}>
        {facts.map((f) => <li>{f}</li>)}
      </ul>
      <p class="footer-made">{COPY.madeIn}</p>
    </div>
  </div>
</footer>
