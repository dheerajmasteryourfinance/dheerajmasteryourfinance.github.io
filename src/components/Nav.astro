---
// Header. Desktop: one row. Under 1040px the links and actions move into a panel that slides in
// from the right. Open state is a checkbox (#navtoggle) so the menu works without JavaScript;
// the backdrop is a <label> for the same checkbox, so tapping it closes the menu.
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import { APP_LOGIN, APP_PLACEHOLDER, EARLY_ACCESS } from '../lib/links.js';
import { getLocale, localize } from '../i18n/index.ts';
import { UI } from '../i18n/ui.ts';
interface Props {
  current: string;
  switchPath: string;
  guides?: { label: string; items: { title: string; href: string; current: boolean }[] }[];
  guidesLabel?: string;
}
const { current, switchPath, guides, guidesLabel } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = UI[locale];
const links = [
  { href: localize('/features/', locale), label: t.nav.product },
  { href: localize('/examples/', locale), label: t.nav.examples },
  { href: localize('/docs/', locale), label: t.nav.docs },
  { href: localize('/company/', locale), label: t.nav.company },
];
const isCurrent = (href: string) => current === href || current.startsWith(href);
---
<header class="site-nav">
  <div class="container nav-row">
    <Logo />
    <label class="navback" for="navtoggle" aria-hidden="true"></label>
    <label class="burger">
      <input type="checkbox" id="navtoggle" class="navchk" aria-label={t.nav.openMenu} />
      <i></i><i></i><i></i>
    </label>
    <div class="navpanel">
      <div class="navhead"><Logo /></div>
      <nav class="navlinks" aria-label={t.nav.label}>
        {links.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>)}
      </nav>
      {guides && guides.length > 0 && (
        <nav class="navguides" aria-label={guidesLabel}>
          {guides.map((g) => (
            <div class="navguide-group">
              <p class="navguide-title">{g.label}</p>
              <ul>
                {g.items.map((i) => <li><a href={i.href} aria-current={i.current ? 'page' : undefined}>{i.title}</a></li>)}
              </ul>
            </div>
          ))}
        </nav>
      )}
      <div class="navactions">
        <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label={t.nav.theme}>
          <svg class="icon-moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8z" /></svg>
          <svg class="icon-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
        <LangSwitch path={switchPath} />
        <a class="nav-signin" href={APP_LOGIN} data-placeholder={APP_PLACEHOLDER} rel="noopener noreferrer">{t.nav.signIn}</a>
        <a class="btn btn-primary nav-cta" href={localize(EARLY_ACCESS, locale)}><span><span class="cta-lead">{t.cta.lead}</span><span class="cta-rest">{t.cta.rest}</span><span class="cta-tail">{t.cta.tail}</span></span></a>
      </div>
    </div>
  </div>
</header>

<script>
  import { initThemeToggle } from '../scripts/theme.ts';
  initThemeToggle();
</script>

<script>
  // Progressive enhancement only: Escape closes the menu, and a link tap closes it before navigating.
  const toggle = document.getElementById('navtoggle');
  if (toggle instanceof HTMLInputElement) {
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.checked) { toggle.checked = false; toggle.focus(); }
    });
    document.querySelectorAll('.navpanel a').forEach((a) => a.addEventListener('click', () => { toggle.checked = false; }));
  }
</script>
