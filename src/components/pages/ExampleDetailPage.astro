---
import Base from '../../layouts/Base.astro';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { APP_REGISTER } from '../../lib/links.js';
import { getLocale, localize } from '../../i18n/index.ts';
import { UI } from '../../i18n/ui.ts';
import { EXAMPLES_COPY } from '../../i18n/examples.ts';
import Blobs from '../motion/Blobs.astro';
import FloatingChips from '../motion/FloatingChips.astro';
import Marquee from '../motion/Marquee.astro';
import siteDesktop from '../../assets/screens/site-desktop.png';
import siteMobile from '../../assets/screens/site-mobile.png';
import langFr from '../../assets/examples/lang-fr-edit.png';
import langDe from '../../assets/examples/lang-de-hero.png';
import langMenu from '../../assets/examples/lang-menu.png';
import langTranslate from '../../assets/examples/lang-translate.png';

const locale = getLocale(Astro.currentLocale);
const t = EXAMPLES_COPY[locale].detail;
const list = EXAMPLES_COPY[locale].list;
const ui = UI[locale];
const l = (p: string) => localize(p, locale);
const langImages = { nl: siteDesktop, fr: langFr, de: langDe } as const;
---
<Base title={t.title} description={t.description} path="/examples/greenleaf-bakery/">
  <section data-section="hero" class="d-hero has-blobs">
    <Blobs variant="hero" />
    <FloatingChips locale={locale} placement="right" />
    <div class="container">
      <p><a class="back" href={l('/examples/')}>{t.back}</a></p>
      <span class="badge">{t.label}</span>
      <p class="place">{t.place}</p>
      <h1>{t.name}</h1>
      <p class="lede">{t.intro}</p>
      <dl class="facts">
        {t.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <section data-section="preview" class="preview">
    <div class="container">
      <div class="frame zoom">
        <Picture
          src={siteDesktop}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1120px) 1078px, calc(100vw - 40px)"
          alt={t.altDesktop}
          loading="lazy"
        />
      </div>
    </div>
    <div class="marq-wrap" aria-hidden="true"><Marquee items={list.marquee} /></div>
  </section>

  <section data-section="made" class="made">
    <div class="container">
      <p class="eyebrow">{t.made.eyebrow}</p>
      <h2>{t.made.title}</h2>
      <div class="grid g3">
        {t.made.steps.map((s, i) => (
          <div class="stopcard">
            <span class="stop-num">{i + 1}</span>
            <h3>{s.t}</h3>
            <p>{s.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section data-section="languages" class="langs band">
    <div class="container">
      <p class="eyebrow">{t.languages.eyebrow}</p>
      <h2>{t.languages.title}</h2>
      <p class="sub">{t.languages.text}</p>
      <div class="grid g3">
        {t.languages.cards.map((c) => (
          <figure class="lang-card lift">
            <div class="lc-shot">
              <Picture
                src={langImages[c.code as keyof typeof langImages]}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[480, 800, 1200]}
                sizes="(min-width: 900px) 360px, calc(100vw - 80px)"
                alt={c.alt}
                loading="lazy"
              />
            </div>
            <figcaption><strong lang={c.code}>{c.native}</strong><span>{c.name}</span></figcaption>
          </figure>
        ))}
      </div>
      <h3 class="how">{t.languages.how}</h3>
      <div class="grid g2 how-grid">
        {[[langMenu, t.languages.altMenu], [langTranslate, t.languages.altTranslate]].map(([src, alt], i) => (
          <figure class="how-card lift">
            <p class="how-step"><span class="stop-num">{i + 1}</span>{t.languages.steps[i]}</p>
            <Picture
              src={src as ImageMetadata}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[480, 800, 1200]}
              sizes="(min-width: 900px) 520px, calc(100vw - 80px)"
              alt={alt as string}
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section data-section="mobile" class="mobile">
    <div class="container two">
      <div>
        <h2>{t.mobile.title}</h2>
        <p class="sub">{t.mobile.text}</p>
      </div>
      <div class="phone zoom">
        <Picture
          src={siteMobile}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[160, 240, 360, 480]}
          sizes="(min-width: 900px) 240px, 60vw"
          alt={t.altPhone}
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section data-section="cta" class="final">
    <div class="container">
      <h2>{t.cta.title}</h2>
      <p>{t.cta.text}</p>
      <a class="btn btn-accent pulse" href={APP_REGISTER} rel="noopener noreferrer">{ui.trialLong}</a>
    </div>
  </section>
</Base>

<style>
  :global(main) > section { margin-top: 80px; }
  :global(main) > section.d-hero { margin-top: 40px; position: relative; }
  :global(main) > section.preview { margin-top: 48px; }
  :global(main) > section.band { background: var(--surface); padding: 64px 0; }
  :global(main) > section.final { background: var(--ink); color: var(--on-dark-2); padding: 80px 0; text-align: center; margin-bottom: 0; }
  :global(main) > section.final h2 { color: var(--white); }
  .final :focus-visible { outline-color: var(--accent); }

  .back { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  .badge { display: inline-block; background: var(--accent); color: var(--ink); font-size: .75rem; font-weight: 700; padding: 6px 12px; border-radius: 999px; }
  .place { margin: 10px 0 0; color: var(--muted); font-size: .9375rem; }
  .d-hero h1 { margin: 6px 0 12px; letter-spacing: -.035em; overflow-wrap: anywhere; }
  .lede { max-width: 640px; font-size: 1.1875rem; color: var(--muted); }
  .facts { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); margin: 28px 0 0; }
  .facts div { border: 1px solid var(--line); border-radius: 16px; padding: 14px 16px; background: var(--white); }
  .facts dt { font: 700 .75rem/1.2 var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: var(--link); }
  .facts dd { margin: 4px 0 0; font-weight: 600; color: var(--ink); overflow-wrap: anywhere; }

  .frame { border: 1px solid var(--line-strong); border-radius: 16px; overflow: hidden; background: var(--white); box-shadow: var(--shadow-lift); }
  .frame :global(img) { display: block; width: 100%; height: auto; }
  .marq-wrap { margin-top: 32px; }

  .eyebrow { font: 700 .8125rem/1.2 var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--link); margin: 0 0 12px; display: block; }
  .sub { max-width: 640px; color: var(--muted); font-size: 1.0625rem; }
  .grid { display: grid; gap: 20px; margin-top: 28px; }
  .g3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .g2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
  .stopcard { border: 1px solid var(--line); border-radius: 20px; padding: 22px; background: var(--white); }
  .stopcard h3 { font-size: 1.25rem; margin: 14px 0 8px; }
  .stopcard p { margin: 0; color: var(--muted); }
  .stop-num { width: 30px; height: 30px; flex: none; border-radius: 50%; background: var(--accent); color: var(--ink); font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }

  .lang-card { margin: 0; background: var(--white); border: 1px solid var(--line); border-radius: 20px; padding: 14px; }
  .lc-shot { border-radius: 12px; overflow: hidden; border: 1px solid var(--line); aspect-ratio: 16 / 10; background: var(--surface); }
  .lc-shot :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .lang-card figcaption { display: flex; justify-content: space-between; gap: 8px; align-items: center; margin-top: 12px; }
  .lang-card figcaption span { font-size: .8125rem; color: var(--muted); }
  .how { margin: 40px 0 0; font-size: 1.25rem; }
  .how-grid { margin-top: 16px; }
  .how-card { margin: 0; background: var(--white); border: 1px solid var(--line); border-radius: 20px; padding: 18px; }
  .how-step { display: flex; align-items: center; gap: 10px; margin: 0 0 12px; font-weight: 600; color: var(--ink); }
  .how-card :global(img) { display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); }

  .two { display: grid; gap: 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); align-items: center; }
  .phone { width: min(100%, 240px); margin: 0 auto; border: 6px solid var(--ink); border-radius: 28px; overflow: hidden; background: var(--ink); box-shadow: var(--shadow-lift); }
  .phone :global(img) { display: block; width: 100%; height: auto; }
  .placeholder-box { border: 2px dashed var(--line-strong); border-radius: 20px; padding: 24px; color: var(--muted); max-width: 720px; }
</style>
