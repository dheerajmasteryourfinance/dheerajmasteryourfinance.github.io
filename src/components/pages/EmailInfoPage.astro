---
import Base from '../../layouts/Base.astro';
import { getLocale, localize } from '../../i18n/index.ts';
import { EMAIL_INFO } from '../../i18n/email.ts';
import Blobs from '../motion/Blobs.astro';

const locale = getLocale(Astro.currentLocale);
const t = EMAIL_INFO[locale];
const l = (p: string) => localize(p, locale);
---
<Base title={t.title} description={t.description} path="/email/">
  <section data-section="quick" class="e-quick has-blobs">
    <Blobs variant="article" />
    <div class="container narrow">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.h1}</h1>
      <p class="lede">{t.lede}</p>
      <div class="answer lift">
        <h2>{t.stop.title}</h2>
        <p>{t.stop.lead}<strong>{t.stop.unsub}</strong>{t.stop.mid}<strong>{t.stop.unsub2}</strong>{t.stop.tail}</p>
        <div class="footer-mock" aria-label={t.stop.mockLabel} role="img">
          <p>{t.stop.mockLine1}</p>
          <p><span class="unsub">{t.stop.mockUnsub}</span>{t.stop.mockLine2}</p>
        </div>
      </div>
    </div>
  </section>

  <section data-section="who">
    <div class="container narrow">
      <h2>{t.who.title}</h2>
      <p>{t.who.text}</p>
    </div>
  </section>

  <section data-section="why">
    <div class="container narrow">
      <h2>{t.why.title}</h2>
      <p>{t.why.text}</p>
    </div>
  </section>

  <section data-section="rules">
    <div class="container">
      <h2>{t.rules.title}</h2>
      <div class="grid">
        {t.rules.cards.map((r) => <div class="card lift"><h3>{r.t}</h3><p>{r.p}</p></div>)}
      </div>
      <p class="muted">{t.rules.policy}</p>
    </div>
  </section>

  <section data-section="spam">
    <div class="container narrow">
      <h2>{t.spam.title}</h2>
      <p>{t.spam.lead}<strong>{t.spam.abuse}</strong>{t.spam.tail}</p>
    </div>
  </section>

  <section data-section="help">
    <div class="container narrow">
      <div class="helpbox lift">
        <div>
          <h2>{t.help.title}</h2>
          <p>{t.help.text}</p>
        </div>
        <a class="btn btn-primary" href={l('/company/#contact')}>{t.help.link}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  :global(main) > section { margin-top: 56px; }
  :global(main) > section.e-quick { margin-top: 48px; position: relative; }
  :global(main) > section[data-section="help"] { margin-bottom: 88px; }
  .eyebrow { font: 700 .8125rem/1.2 var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--link); margin: 0 0 12px; display: block; }
  .narrow { max-width: 760px; }
  .e-quick h1 { letter-spacing: -.035em; }
  .lede { font-size: 1.1875rem; color: var(--muted); }
  .answer { background: var(--tint); border-radius: 20px; padding: 28px; margin-top: 28px; }
  .answer h2 { font-size: 1.5rem; }
  .footer-mock { background: var(--white); border: 1px solid var(--line-strong); border-radius: 12px; padding: 14px 16px; font-size: .9375rem; color: var(--muted); }
  .footer-mock p { margin: 0 0 4px; }
  .footer-mock p:last-child { margin: 0; }
  .unsub { color: var(--link); text-decoration: underline; }
  .grid { display: grid; gap: 20px; margin-top: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .card { background: var(--white); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
  .card h3 { margin-bottom: 8px; }
  .card p { margin: 0; }
  .muted { color: var(--muted); margin-top: 20px; }
  .helpbox { display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between; background: var(--surface); border-radius: 20px; padding: 28px; }
  .helpbox h2 { font-size: 1.5rem; margin-bottom: 4px; }
  .helpbox p { margin: 0; }
</style>
