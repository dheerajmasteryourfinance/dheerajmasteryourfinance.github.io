---
import Base from '../../layouts/Base.astro';
import { Picture } from 'astro:assets';
import { EARLY_ACCESS } from '../../lib/links.js';
import { getLocale, localize } from '../../i18n/index.ts';
import { HOME } from '../../i18n/home.ts';
import { EXAMPLES } from '../../lib/examples.ts';
import Blobs from '../motion/Blobs.astro';
import FloatingChips from '../motion/FloatingChips.astro';
import Route from '../Route.astro';
import ExampleCard from '../ExampleCard.astro';
import TrustCards from '../TrustCards.astro';
import StickyCta from '../StickyCta.astro';
import editorEdit from '../../assets/screens/editor-edit.png';
import siteDesktop from '../../assets/screens/site-desktop.png';
import siteMobile from '../../assets/screens/site-mobile.png';

const locale = getLocale(Astro.currentLocale);
const t = HOME[locale];
const l = (p: string) => localize(p, locale);
const strip = EXAMPLES.filter((e) => e.id !== 'greenleaf');
const check = (
  '<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"/></svg>'
);
---
<Base title={t.title} description={t.description} path="/" orgJsonLd>
  <p class="announce" slot="top">
    <span>{t.announce.text}</span>
    <a href={l('/docs/follow-up-emails/')}>{t.announce.link}</a>
  </p>

  <section data-section="hero" class="hero has-blobs">
    <Blobs variant="hero" />
    <div class="container">
      <div class="switch" role="group" aria-label={t.hero.switchLabel}>
        <button type="button" data-audience-btn="business" aria-pressed="true">{t.hero.business}</button>
        <button type="button" data-audience-btn="agency" aria-pressed="false">{t.hero.agency}</button>
      </div>
      <h1 data-audience="business">{t.hero.h1Business[0]} <mark>{t.hero.h1Business[1]}</mark></h1>
      <h1 data-audience="agency" hidden>{t.hero.h1Agency[0]} <mark>{t.hero.h1Agency[1]}</mark></h1>
      <p class="lede" data-audience="business">{t.hero.ledeBusiness}</p>
      <p class="lede" data-audience="agency" hidden>{t.hero.ledeAgency}</p>
      <div class="cta-row">
        <a class="btn btn-accent pulse" href={l(EARLY_ACCESS)}>{t.hero.cta}</a>
        <a class="btn btn-ghost" href="#proof">{t.hero.example}</a>
      </div>
      <ul class="chips">
        {t.hero.chips.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section data-section="shot" class="shotsec has-blobs" aria-label={t.shot.label}>
    <Blobs variant="card" />
    <div class="container shot-wrap">
      <figure class="shot">
        <div class="shot-bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <Picture
          src={editorEdit}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1120px) 1078px, calc(100vw - 42px)"
          alt={t.shot.alt}
          loading="eager"
          fetchpriority="high"
          class="shot-img"
        />
        <figcaption>{t.shot.caption}</figcaption>
      </figure>
      <FloatingChips locale={locale} placement="around-shot" />
    </div>
  </section>

  <section data-section="problem">
    <div class="container">
      <p class="eyebrow">{t.problem.eyebrow}</p>
      <h2>{t.problem.title}</h2>
      <div class="grid g3">
        {t.problem.cards.map((c) => <div class="card lift"><h3>{c.t}</h3><p>{c.p}</p></div>)}
      </div>
    </div>
  </section>

  <section data-section="guide" class="band">
    <div class="container two">
      <div>
        <h2>{t.guide.title}</h2>
        <p>{t.guide.text}</p>
      </div>
      <div class="stack">
        {t.guide.cards.map((c) => <div class="card lift"><h3>{c.t}</h3><p>{c.p}</p></div>)}
      </div>
    </div>
  </section>

  <section data-section="how" id="how">
    <div class="container">
      <p class="eyebrow">{t.how.eyebrow}</p>
      <h2>{t.how.title}</h2>
      <Route stops={t.how.stops.map((label) => ({ label }))} mode="scroll" ariaLabel={t.how.routeLabel} />
      <div class="grid g3 stops">
        {t.how.cards.map((c, i) => (
          <div class="stopcard">
            <div class="stop-head"><span class="stop-num">{i + 1}</span><span class="stop-tag">{c.tag}</span></div>
            <h3>{c.t}</h3>
            <p>{c.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section data-section="get" class="band">
    <div class="container">
      <div class="head-row">
        <div><p class="eyebrow">{t.get.eyebrow}</p><h2>{t.get.title}</h2></div>
        <a href={l('/features/')}>{t.get.more}</a>
      </div>
      <div class="grid g3">
        {t.get.groups.map((g, i) => (
          <div class="card lift get-group">
            <span class="num">{i + 1}</span>
            <h3>{g.t}</h3>
            <ul class="ticks">
              {g.items.map((x) => <li><span set:html={check} />{x}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="note">{t.get.note}</p>
    </div>
  </section>

  <section data-section="proof" id="proof">
    <div class="container">
      <div class="head-row">
        <div>
          <p class="eyebrow">{t.proof.eyebrow}</p>
          <h2>{t.proof.title}</h2>
          <p class="sub">{t.proof.text}</p>
        </div>
        <a href={l('/examples/')}>{t.proof.all}</a>
      </div>
      <div class="proof-main lift">
        <div class="proof-top">
          <div><div class="proof-name">{t.proof.name}</div><div class="proof-place">{t.proof.place}</div></div>
          <span class="badge">{t.proof.label}</span>
        </div>
        <div class="ex-shots zoom">
          <Picture
            src={siteDesktop}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1120px) 1030px, calc(100vw - 90px)"
            alt={t.proof.altDesktop}
            loading="lazy"
            class="ex-desktop"
          />
          <Picture
            src={siteMobile}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[160, 240, 360, 480]}
            sizes="(min-width: 1120px) 220px, 22vw"
            alt={t.proof.altPhone}
            loading="lazy"
            class="ex-phone"
          />
        </div>
        <ul class="tagrow">{t.proof.tags.map((x) => <li>{x}</li>)}</ul>
      </div>

      <h3 class="strip-title">{t.proof.stripTitle}</h3>
      <div class="strip">
        {strip.map((site) => <ExampleCard site={site} locale={locale} size="strip" href={l('/examples/')} />)}
      </div>

      <div class="inbox">
        <div>
          <h3>{t.proof.inbox.t}</h3>
          <a href={l('/email/')}>{t.proof.inbox.link}</a>
        </div>
        <ul class="chiprow">
          {t.proof.inbox.chips.map((x) => <li><span set:html={check} />{x}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <TrustCards locale={locale} />

  <section data-section="faq" class="band">
    <div class="container narrow">
      <h2>{t.faq.title}</h2>
      {t.faq.items.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>

  <section data-section="cta" class="final">
    <div class="container">
      <h2>{t.cta.title}</h2>
      <p>{t.cta.text}</p>
      <a class="btn btn-accent pulse" href={l(EARLY_ACCESS)}>{t.hero.cta}</a>
    </div>
  </section>

  <StickyCta locale={locale} slot="after" />
</Base>

<script>
  import { initAudienceSwitch } from '../../scripts/audience.js';
  initAudienceSwitch(document.body);
</script>

<style is:global>
  main > section { margin-top: 88px; }
  main > section.hero { margin-top: 32px; text-align: center; padding-top: 16px; }
  main > section.shotsec { margin-top: 56px; }
  main > section.band { background: var(--surface); padding: 64px 0; }
  main > section.final { background: var(--ink); color: var(--on-dark-2); padding: 80px 0; text-align: center; margin-bottom: 0; }
  main > section.final h2 { color: var(--white); }
  main > section.final :focus-visible { outline-color: var(--accent); }
  [hidden] { display: none !important; }

  .announce { margin: 0; padding: 10px 20px; background: var(--ink); color: var(--white); text-align: center; font-size: .9375rem; }
  .announce a { color: var(--accent); font-weight: 600; margin-left: 8px; display: inline-flex; align-items: center; min-height: 44px; }

  .eyebrow { font: 700 .8125rem/1.2 var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--link); margin: 0 0 12px; display: block; }
  .narrow { max-width: 760px; }
  .lede { max-width: 680px; margin: 0 auto 28px; font-size: 1.1875rem; color: var(--muted); }
  .sub { max-width: 620px; margin: 14px 0 0; color: var(--muted); font-size: 1.125rem; }
  .hero h1 { max-width: 920px; margin: 32px auto 20px; letter-spacing: -.035em; }
  mark { background: linear-gradient(transparent 62%, var(--accent) 62%); color: inherit; padding: 0 6px; }
  .switch { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; }
  .switch button { min-height: 44px; padding: 0 20px; border: 0; border-radius: 999px; background: transparent; color: var(--ink); font: 600 1rem/1 var(--font-body); cursor: pointer; }
  .switch button[aria-pressed="true"] { background: var(--ink); color: var(--white); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px 20px; justify-content: center; list-style: none; padding: 0; margin: 24px 0 0; color: var(--muted); font-size: .9375rem; }

  .grid { display: grid; gap: 20px; margin-top: 32px; }
  .g3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .two { display: grid; gap: 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); align-items: center; }
  .stack { display: grid; gap: 16px; }
  .card { background: var(--surface); border-radius: 20px; padding: 24px; }
  .band .card { background: var(--white); border: 1px solid var(--line); }
  .card h3 { margin-bottom: 8px; }
  .card p:last-child { margin-bottom: 0; }
  .num { font: 800 1.5rem/1 var(--font-heading); color: var(--link); display: block; margin-bottom: 12px; }
  .head-row { display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; align-items: flex-end; }
  .head-row a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  .note { margin: 28px 0 0; color: var(--muted); max-width: 760px; }

  .shot-wrap { position: relative; }
  .shot { margin: 0 auto; border: 1px solid var(--line-strong); border-radius: 16px; overflow: hidden; background: var(--white); box-shadow: var(--shadow-lift); }
  .shot figcaption { padding: 12px 18px; font-size: .875rem; color: var(--muted); border-top: 1px solid var(--line); }
  .shot-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--surface); border-bottom: 1px solid var(--line); }
  .shot-bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--line-strong); }
  .shot-img { display: block; width: 100%; height: auto; }

  .stops { margin-top: 12px; }
  .stopcard { border: 1px solid var(--line); border-radius: 20px; padding: 22px; background: var(--white); }
  .stop-head { display: flex; align-items: center; gap: 10px; }
  .stop-num { width: 30px; height: 30px; border-radius: 50%; background: var(--accent); color: var(--ink); font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .stop-tag { font-size: .75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--link); }
  .stopcard h3 { font-size: 1.25rem; margin: 14px 0 8px; }
  .stopcard p { margin: 0; color: var(--muted); }

  .ticks { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 12px; }
  .ticks li { display: flex; align-items: flex-start; gap: 10px; overflow-wrap: anywhere; }
  .ticks svg, .chiprow svg { flex: none; margin-top: 4px; color: var(--link); }

  .proof-main { margin-top: 36px; background: linear-gradient(160deg, #F8FAFF 0%, #E9EFFA 100%); border-radius: 24px; padding: 28px; display: flex; flex-direction: column; }
  .proof-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; }
  .proof-name { font: 700 1.375rem/1.2 var(--font-heading); letter-spacing: -.02em; color: var(--ink); }
  .proof-place { font-size: .875rem; color: var(--muted); margin-top: 2px; }
  .badge { background: var(--accent); color: var(--ink); font-size: .75rem; font-weight: 700; padding: 6px 12px; border-radius: 999px; }
  .ex-shots { position: relative; margin-top: 22px; padding-bottom: 36px; }
  .ex-desktop { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow-lift); background: var(--white); }
  .ex-phone { position: absolute; right: 4%; bottom: 0; width: 24%; height: auto; border: 5px solid var(--ink); border-radius: 20px; background: var(--ink); box-shadow: var(--shadow-lift); }
  .tagrow, .chiprow { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tagrow { margin-top: 20px; }
  .tagrow li, .chiprow li { background: var(--white); border: 1px solid var(--line); border-radius: 999px; padding: 7px 14px; font-size: .875rem; }
  .chiprow li { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--ink); padding: 9px 16px; }
  .chiprow svg { margin-top: 0; }
  .strip-title { margin: 28px 0 12px; font-size: .9375rem; font-family: var(--font-body); font-weight: 600; color: #334155; }
  .strip { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .inbox { margin-top: 20px; border: 1px solid var(--line); border-radius: 24px; padding: 28px; display: flex; flex-wrap: wrap; gap: 20px 32px; align-items: center; justify-content: space-between; }
  .inbox h3 { font-size: 1.375rem; letter-spacing: -.02em; margin: 0; }
  .inbox a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; margin-top: 4px; }

  [data-section="faq"] details { border-bottom: 1px solid var(--line-strong); padding: 4px 0; }
  [data-section="faq"] summary { min-height: 44px; display: flex; align-items: center; cursor: pointer; font-weight: 600; color: var(--ink); }
  [data-section="faq"] details p { margin: 0 0 14px; }
</style>
