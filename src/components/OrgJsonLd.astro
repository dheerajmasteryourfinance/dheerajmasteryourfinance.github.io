---
import { safeJson } from '../lib/json-ld.mjs';
const data = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'WebGen',
  url: 'https://website-generator.nl/',
  email: '[SUPPORT EMAIL]',
  address: { '@type': 'PostalAddress', streetAddress: '[ADDRESS]' },
};
// Escape "<" so no value can ever close the script element early.
const json = safeJson(data);
---
<script type="application/ld+json" set:html={json} />
