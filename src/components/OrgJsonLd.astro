---
import { safeJson } from '../lib/json-ld.mjs';
import { COMPANY } from '../lib/company.ts';
const data = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Webgnr',
  url: 'https://webgnr.com/',
  address: { '@type': 'PostalAddress', streetAddress: COMPANY.street, postalCode: COMPANY.postcode, addressLocality: COMPANY.city, addressCountry: 'NL' },
};
// Escape "<" so no value can ever close the script element early.
const json = safeJson(data);
---
<script type="application/ld+json" set:html={json} />
