---
import Base from '../../layouts/Base.astro';
import { COMPANY, kvkLine, vatLine } from '../../lib/company.ts';
const topics = [
  'A question about WebGen',
  'Help with my account',
  'Agency or partnership',
  'An email I received',
];
---
<Base
  title="About WebGen and contact"
  description="Who is behind WebGen, what we stand for, and how to reach a person."
  path="/company/"
>
  <section data-section="about" class="c-about">
    <div class="container">
      <p class="eyebrow">About us</p>
      <h1>We think every small business deserves a website that works for it.</h1>
      <div class="two">
        <div>
          <p>Getting online used to mean hiring a designer, a developer and a marketing tool, then making them talk to each other. Most small businesses never got past the first step.</p>
          <p>WebGen puts the website, the sign-up forms and the email in one place, and writes the first version for you. [CONFIRM: founding story and who is behind WebGen]</p>
        </div>
        <dl class="facts">
          <div><dt>Founded</dt><dd>[YEAR]</dd></div>
          <div><dt>Based in</dt><dd>{COMPANY.city}</dd></div>
          <div><dt>Operated by</dt><dd>{COMPANY.legalName}<br />{kvkLine()}<br />{vatLine('en')}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section data-section="values" class="band">
    <div class="container">
      <h2>What we stand for</h2>
      <div class="grid">
        <div class="card"><h3>Plain language</h3><p>No jargon in the product or in our support replies.</p></div>
        <div class="card"><h3>Consent first</h3><p>People only get email they asked for, and can leave in one click.</p></div>
        <div class="card"><h3>Your business, your data</h3><p>[CONFIRM: ownership and export promise]</p></div>
      </div>
    </div>
  </section>

  <section id="contact" data-section="contact">
    <div class="container two top">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Talk to a person.</h2>
        <p>We reply within [RESPONSE TIME] on working days.</p>
        <div class="stack">
          <div class="card"><h3>Support</h3><p>[SUPPORT EMAIL]</p></div>
          <div class="card">
            <h3>Report spam or abuse</h3>
            <p>[ABUSE EMAIL]</p>
            <p><a class="inline" href="/email/">Got an email you did not expect? →</a></p>
          </div>
          <div class="card"><h3>Phone</h3><p>{COMPANY.phone}</p></div>
          <div class="card"><h3>Postal address</h3><p>[LEGAL ENTITY NAME]<br />[POSTAL ADDRESS]</p></div>
        </div>
      </div>
      <div class="card formcard">
        <form method="post">
          <div class="field">
            <label for="c-name">Name</label>
            <input id="c-name" type="text" name="name" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="c-email">Email</label>
            <input id="c-email" type="email" name="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="c-topic">Topic</label>
            <select id="c-topic" name="topic">
              {topics.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="c-message">Message</label>
            <textarea id="c-message" name="message" required rows="5"></textarea>
          </div>
          <p class="note">We use your details only to reply. See our <a href="/privacy/">privacy policy</a>.</p>
          <button class="btn btn-primary" type="submit">Send message</button>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  main > section { margin-top: 72px; }
  main > section.c-about { margin-top: 56px; }
  main > section.band { background: var(--surface); padding: 56px 0; }
  .eyebrow { font: 700 .8125rem/1.2 var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; display: block; }
  .c-about h1 { max-width: 860px; letter-spacing: -.03em; }
  .two { display: grid; gap: 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); margin-top: 32px; }
  .two.top { margin-top: 0; align-items: start; }
  .facts { display: grid; gap: 12px; margin: 0; }
  .facts > div { background: var(--surface); border-radius: 16px; padding: 16px 20px; }
  .facts dt { font: 700 .75rem/1.2 var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  .facts dd { margin: 0; color: var(--ink); font-weight: 600; }
  .grid { display: grid; gap: 20px; margin-top: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .card { background: var(--white); border: 1px solid var(--line); border-radius: 16px; padding: 24px; }
  .card h3 { margin-bottom: 8px; }
  .card p:last-child { margin-bottom: 0; }
  .stack { display: grid; gap: 16px; margin-top: 24px; }
  .inline { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  .formcard { padding: 28px; }
  .field { display: grid; gap: 6px; margin-bottom: 16px; }
  .field label { font-weight: 600; color: var(--ink); }
  .field input, .field select, .field textarea {
    width: 100%; min-height: 44px; padding: 10px 12px;
    border: 1px solid var(--line-strong); border-radius: 10px;
    font: 400 1rem/1.4 var(--font-body); color: var(--body); background: var(--white);
  }
  .field textarea { resize: vertical; }
  .note { color: var(--muted); font-size: .9375rem; }
</style>
