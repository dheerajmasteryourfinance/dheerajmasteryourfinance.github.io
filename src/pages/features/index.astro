---
import Base from '../../layouts/Base.astro';
const APP = 'https://app.website-generator.nl/register';
const chips = [
  { id: 'build', label: 'Build' },
  { id: 'leads', label: 'Forms and audience' },
  { id: 'email', label: 'Email' },
  { id: 'search', label: 'Search and analytics' },
  { id: 'domains', label: 'Domains and senders' },
];
---
<Base
  title="WebGen features: build, grow and send"
  description="Everything WebGen does, from the first draft of your site to the hundredth email."
  path="/features/"
>
  <section data-section="hero" class="f-hero">
    <div class="container">
      <p class="eyebrow">Product</p>
      <h1>One tool to build the site and grow the business behind it.</h1>
      <p class="lede">Here is everything WebGen does, from the first draft of your site to the hundredth email.</p>
      <nav aria-label="Feature sections" class="chip-nav">
        {chips.map((c) => <a href={`#${c.id}`}>{c.label}</a>)}
      </nav>
    </div>
  </section>

  <section id="build" data-section="build" class="row">
    <div class="container split">
      <div>
        <p class="eyebrow">01 · Build</p>
        <h2>From a short brief to a full site.</h2>
        <p class="copy">Describe what you do and who you serve. WebGen writes the pages, picks a layout and applies your brand colours and fonts.</p>
        <ul class="ticks">
          <li>Click any text or image to change it</li>
          <li>Ask for bigger changes in a sentence</li>
          <li>Import an existing site from a ZIP file</li>
        </ul>
      </div>
      <div class="mock" aria-hidden="true">
        <div class="panel">
          <p class="mock-label">Your brief</p>
          <p>A family physiotherapy clinic in Leeds. Sports injuries, back pain, online booking.</p>
          <ul class="pills"><li>Home</li><li>Treatments</li><li>Team</li><li>Book</li></ul>
        </div>
        <div class="tiles"><i></i><i></i><i></i></div>
      </div>
    </div>
  </section>

  <section id="leads" data-section="leads" class="row">
    <div class="container split flip">
      <div>
        <p class="eyebrow">02 · Forms and audience</p>
        <h2>Every sign-up in one list.</h2>
        <p class="copy">Contact, booking and lead-magnet forms all feed one audience. Each person is tagged by where they signed up, so you can group them into segments later.</p>
        <ul class="ticks">
          <li>Double opt-in, so every subscriber confirmed</li>
          <li>Segments by tag, source or activity</li>
          <li>Spam protection on every form</li>
        </ul>
      </div>
      <div class="mock" aria-hidden="true">
        <div class="panel table">
          <div class="tr th"><span>Contact</span><span>Source</span><span>Status</span></div>
          <div class="tr"><span>Priya S.</span><span>Booking form</span><span class="ok">Subscribed</span></div>
          <div class="tr"><span>Tom W.</span><span>Free guide</span><span class="wait">Awaiting confirm</span></div>
          <div class="tr"><span>Ana R.</span><span>Contact form</span><span class="ok">Subscribed</span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="email" data-section="email" class="row">
    <div class="container split">
      <div>
        <p class="eyebrow">03 · Email</p>
        <h2>Newsletters and sequences, without another tool.</h2>
        <p class="copy">Write a campaign with the email builder, or let the AI draft it. Set up sequences that greet and follow up on their own. Every send is paced and retried, and logged so you can see what went out.</p>
        <ul class="ticks">
          <li>Drag-and-drop email builder with AI drafts</li>
          <li>Automated sequences with delays</li>
          <li>Sent-email log and campaign stats</li>
        </ul>
      </div>
      <div class="mock dark" aria-hidden="true">
        <p class="mock-label">Welcome sequence</p>
        <ul class="steps">
          <li class="step"><span>Thanks for joining</span><span>Right away</span></li>
          <li class="wait-note">wait 2 days</li>
          <li class="step"><span>Three tips to get started</span><span>Day 2</span></li>
          <li class="wait-note">wait 5 days</li>
          <li class="step"><span>Your first-visit offer</span><span>Day 7</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section id="search" data-section="search" class="row">
    <div class="container">
      <p class="eyebrow">04 · Search and analytics</p>
      <h2>Be found, then see what works.</h2>
      <div class="cards">
        <div class="card"><h3>Sitemap and robots</h3><p>Generated for every site. Your own uploaded files are always kept.</p></div>
        <div class="card"><h3>Search and social tags</h3><p>Titles, descriptions, link previews and structured data.</p></div>
        <div class="card"><h3>Analytics</h3><p>Visits, sign-ups and email results, only after visitors consent.</p></div>
      </div>
    </div>
  </section>

  <section id="domains" data-section="domains" class="row">
    <div class="container split flip">
      <div>
        <p class="eyebrow">05 · Domains and senders</p>
        <h2>Your name on the site and in the inbox.</h2>
        <p class="copy">Connect your own domain with automatic HTTPS. Verify a sender so emails come from your address, and we keep checking it stays set up correctly.</p>
        <p><a class="more" href="/docs/connect-your-domain/">Read the domain guide →</a></p>
      </div>
      <div class="mock" aria-hidden="true">
        <div class="panel status">
          <p><span>clinic.co.uk</span><span class="ok">Connected</span></p>
          <p><span>Sender: your own address</span><span class="ok">Verified</span></p>
          <p><span>HTTPS certificate</span><span class="ok">Active</span></p>
        </div>
      </div>
    </div>
  </section>

  <section data-section="cta" class="final">
    <div class="container">
      <h2>Try it on your own business.</h2>
      <div class="cta-row">
        <a class="btn btn-accent" href={APP} rel="noopener noreferrer">Build my site</a>
        <a class="btn btn-ondark" href="/docs/">Read the guides</a>
      </div>
    </div>
  </section>
</Base>

<style>
  main > section { margin-top: 88px; }
  main > section.f-hero { margin-top: 56px; }
  main > section.final { background: var(--ink); color: var(--on-dark-2); padding: 72px 0; text-align: center; }
  main > section.final h2 { color: var(--white); }
  [hidden] { display: none !important; }

  .eyebrow { font: 700 .8125rem/1.2 var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; display: block; }
  .f-hero h1 { max-width: 860px; letter-spacing: -.03em; }
  .lede { max-width: 640px; font-size: 1.1875rem; color: var(--muted); }
  .chip-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 32px; }
  .chip-nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 1px solid var(--line-strong); border-radius: 999px; color: var(--ink); text-decoration: none; font-size: .9375rem; }
  .chip-nav a:hover { border-color: var(--ink); }

  .split { display: grid; gap: 48px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); align-items: center; }
  .copy { color: var(--muted); font-size: 1.0625rem; }
  .ticks { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 12px; }
  .ticks li { position: relative; padding-left: 30px; }
  .ticks li::before { content: "\2713"; position: absolute; left: 0; top: 0; font-weight: 800; color: var(--link); }
  .more { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }

  .mock { background: var(--surface); border-radius: 24px; padding: 24px; }
  .mock.dark { background: var(--ink); color: var(--white); }
  .mock-label { font: 700 .75rem/1.2 var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; }
  .dark .mock-label { color: var(--on-dark); }
  .panel { background: var(--white); border: 1px solid var(--line); border-radius: 16px; padding: 20px; font-size: .9375rem; }
  .panel p:last-child { margin-bottom: 0; }
  .pills { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pills li { background: var(--tint); color: var(--link); border-radius: 999px; padding: 6px 12px; font-size: .8125rem; font-weight: 600; }
  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 12px; }
  .tiles i { height: 100px; border-radius: 12px; background: var(--tint); border: 1px solid var(--line); }
  .tiles i:nth-child(2) { background: var(--line); }

  .table { padding: 0; overflow: hidden; }
  .tr { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; padding: 12px 16px; border-top: 1px solid var(--line); }
  .tr.th { background: var(--surface); border-top: 0; font-weight: 700; color: var(--ink); }
  .tr span:nth-child(2) { color: var(--muted); }
  .ok { color: var(--link); font-weight: 600; }
  .wait { color: var(--muted); font-weight: 600; }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; font-size: .9375rem; }
  .step { display: flex; justify-content: space-between; gap: 12px; padding: 14px 16px; border: 1px solid var(--on-dark-line); border-radius: 12px; }
  .step span:last-child { color: var(--on-dark); }
  .wait-note { text-align: center; color: var(--on-dark); font-size: .8125rem; }

  .cards { display: grid; gap: 16px; margin-top: 32px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .card { background: var(--surface); border-radius: 20px; padding: 28px; }
  .card h3 { margin-bottom: 8px; }
  .card p { margin: 0; color: var(--muted); font-size: .9375rem; }

  .status p { display: flex; justify-content: space-between; gap: 12px; margin: 0 0 12px; }

  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 28px; }
  .btn-ondark { background: transparent; color: var(--white); border-color: var(--on-dark); }
  .btn-ondark:hover { border-color: var(--white); color: var(--white); }
</style>
