---
import Base from '../layouts/Base.astro';
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { EARLY_ACCESS } from '../lib/links.js';
import editorEdit from '../assets/screens/editor-edit.png';
import editorAi from '../assets/screens/editor-ai.png';
import siteDesktop from '../assets/screens/site-desktop.png';
import siteMobile from '../assets/screens/site-mobile.png';
const cards = [
  { href: '/docs/build-your-first-website/', tag: 'Getting started', slug: 'build-your-first-website', title: 'Build your first site', text: 'From brief to published, step by step.' },
  { href: '/docs/connect-your-domain/', tag: 'Domains', slug: 'connect-your-domain', title: 'Connect your domain', text: 'Point your address at your site.' },
  { href: '/docs/send-a-campaign/', tag: 'Email', slug: 'send-a-campaign', title: 'Send your first newsletter', text: 'Set up a sender and reach your audience.' },
  { href: '/docs/follow-up-emails/', tag: 'Email', slug: 'follow-up-emails', title: 'Automate a welcome sequence', text: 'Greet every new subscriber on time.' },
];
const learn = await Promise.all(cards.map(async (c) => {
  const entry = await getEntry('docs', c.slug);
  return { ...c, tag: `${c.tag} · ${entry.data.minutes} min` };
}));
---
<Base
  title="WebGen: your website, built for you"
  description="Describe your business and WebGen builds a complete site with forms, newsletters and search basics ready to go."
  path="/"
>
  <section data-section="hero" class="hero">
    <div class="container">
      <div class="switch" role="group" aria-label="Who are you building for">
        <button type="button" data-audience-btn="business" aria-pressed="true">For businesses</button>
        <button type="button" data-audience-btn="agency" aria-pressed="false">For agencies</button>
      </div>
      <h1 data-audience="business">Your website, built for you. <span class="mark">Marketing included.</span></h1>
      <h1 data-audience="agency" hidden>Ship client sites faster. <span class="mark">Send email as the client.</span></h1>
      <p class="lede" data-audience="business">Describe your business and get a complete site with forms, newsletters and search basics ready to go. No designer, no developer, no extra tools.</p>
      <p class="lede" data-audience="agency" hidden>Generate, edit and publish for every client from one account. Each client keeps their own domain, sender identity, audience and reports.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={EARLY_ACCESS}>Request early access</a>
        <a class="btn btn-ghost" href="#examples">See an example</a>
      </div>
      <ul class="chips">
        <li>Optional double opt-in</li>
        <li>Easy unsubscribe</li>
        <li>Your own domain</li>
      </ul>
    </div>
  </section>

  <section data-section="product" class="product" aria-label="Product preview">
    <div class="container">
      <div class="shot">
        <div class="shot-bar" aria-hidden="true"><i></i><i></i><i></i></div>
        <Picture
          src={editorEdit}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1120px) 1078px, calc(100vw - 42px)"
          alt="The WebGen editor in Edit mode, showing the GreenLeaf Bakery homepage with its headline selected and the text toolbar above it"
          loading="eager"
          fetchpriority="high"
          class="shot-img"
        />
      </div>
    </div>
  </section>

  <section id="examples" data-section="examples">
    <div class="container">
      <h2>Built with WebGen</h2>
      <div class="ex-grid">
        <div class="ex-card ex-main">
          <div class="ex-art ex-shots">
            <Picture
              src={siteDesktop}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 1120px) 1030px, calc(100vw - 90px)"
              alt="The GreenLeaf Bakery website on a desktop screen, opening on the problem it solves for its customers"
              loading="lazy"
              class="ex-desktop"
            />
            <Picture
              src={siteMobile}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[160, 240, 360, 480]}
              sizes="(min-width: 1120px) 220px, 22vw"
              alt="The GreenLeaf Bakery website on a phone, with its headline and order button"
              loading="lazy"
              class="ex-phone"
            />
          </div>
          <div class="ex-text">
            <p class="ex-label">Example site</p>
            <h3>GreenLeaf Bakery</h3>
            <p>Amsterdam bakery</p>
          </div>
        </div>
        <div class="ex-card">
          <div class="ex-art ex-blank" aria-hidden="true"></div>
          <div class="ex-text"><h3>[CONFIRM: customer site + permission]</h3></div>
        </div>
        <div class="ex-card">
          <div class="ex-art ex-blank" aria-hidden="true"></div>
          <div class="ex-text"><h3>[CONFIRM: customer site + permission]</h3></div>
        </div>
      </div>
    </div>
  </section>

  <section data-section="problem">
    <div class="container">
      <p class="eyebrow">Sound familiar?</p>
      <h2>Getting online shouldn't need a big budget or a tech team.</h2>
      <div class="grid g3">
        <div class="card"><h3>"I don't know where to start."</h3><p>Hosting, templates, plugins, email tools. Every choice leads to five more.</p></div>
        <div class="card"><h3>"I can't afford a designer and a developer."</h3><p>A custom site and a marketing setup can cost more than a small business spends in a year.</p></div>
        <div class="card"><h3>"I worry it will look amateur."</h3><p>Next to competitors with polished sites, a weak one can cost you the customer.</p></div>
      </div>
    </div>
  </section>

  <section data-section="guide" class="band">
    <div class="container two">
      <div>
        <h2>We know your time goes to your business, not to learning web tools.</h2>
        <p>That is why WebGen asks about your customers, not about code. Your answers are turned into a clear message, a site built around it, and the tools to keep in touch.</p>
      </div>
      <div class="stack">
        <div class="card"><h3>Written with a proven story framework</h3><p>[CONFIRM: name StoryBrand publicly]</p></div>
        <div class="card"><h3>Trusted by real businesses</h3><p>[PROOF: Master Your Business and Mastercrest Games sites, if agreed]</p></div>
      </div>
    </div>
  </section>

  <section data-section="value">
    <div class="container">
      <p class="eyebrow">Everything in one place</p>
      <h2>A website is the start. Growing from it is the point.</h2>
      <div class="bento">
        <div class="card wide">
          <div class="wide-text">
            <h3>Launch without a designer</h3>
            <p>Pages, copy and layout in minutes. Then change anything by clicking it, or by asking in a sentence.</p>
            <ul class="pills"><li>Home</li><li>About</li><li>Services</li><li>Contact</li><li>+ New page</li></ul>
          </div>
          <Picture
            src={editorAi}
            formats={['avif']}
            fallbackFormat="webp"
            widths={[480, 800, 1200]}
            sizes="(min-width: 960px) 620px, 120vw"
            alt="The AI assistant panel open beside the GreenLeaf Bakery homepage, ready for a request such as a new section"
            loading="lazy"
            class="wide-shot"
          />
        </div>
        <div class="card card-dark">
          <h3>Stay in touch with every lead</h3>
          <p>Campaigns and automated sequences sent from your own domain, with consent and unsubscribe handled for you.</p>
          <ul class="seq">
            <li><span>Welcome email</span><span>Day 0</span></li>
            <li><span>Getting started tips</span><span>Day 2</span></li>
            <li><span>Special offer</span><span>Day 7</span></li>
          </ul>
        </div>
        <div class="card"><h3>Know who is interested</h3><p>Every form feeds one audience, tagged by where people signed up.</p></div>
        <div class="card"><h3>Get found by customers</h3><p>Sitemap, search tags and structured data, generated and kept current. [CONFIRM: ships with the SEO release]</p></div>
        <div class="card"><h3>See what works</h3><p>Visits, sign-ups and email results in one view, with visitor consent respected.</p></div>
      </div>
      <p class="more"><a href="/features/">Explore all features →</a></p>
    </div>
  </section>

  <section data-section="plan" class="band">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2>Three steps to a site that works.</h2>
      <ol class="grid g3 steps">
        <li class="card"><span class="num">01</span><h3>Tell us about your business</h3><p>Answer a short brief about who you serve and how you help them.</p></li>
        <li class="card"><span class="num">02</span><h3>Review your site</h3><p>Get a full site with pages and copy. Change anything by clicking it or asking.</p></li>
        <li class="card"><span class="num">03</span><h3>Publish</h3><p>Go live on your domain with forms and email connected.</p></li>
      </ol>
    </div>
  </section>

  <section data-section="audience">
    <div class="container">
      <div data-audience="business">
        <h2>For owners who would rather run the business than the website.</h2>
        <div class="grid g3">
          <div class="card"><h3>One place for everything</h3><p>Site, leads and email live together, so nothing falls between tools.</p></div>
          <div class="card"><h3>No jargon</h3><p>Plain-language steps and sensible defaults from the first minute.</p></div>
          <div class="card"><h3>Grows with you</h3><p>Start with a page. Add a newsletter and follow-ups when you are ready.</p></div>
        </div>
      </div>
      <div data-audience="agency" hidden>
        <h2>For agencies who manage many clients without many logins.</h2>
        <div class="grid g3">
          <div class="card"><h3>Every client kept apart</h3><p>Each client has their own site, audience and reports.</p></div>
          <div class="card"><h3>Send as the client</h3><p>Emails go out from the client's own domain and name, not yours.</p></div>
          <div class="card"><h3>Hand over when ready</h3><p>[CONFIRM: site and account hand-over to the client]</p></div>
        </div>
      </div>
    </div>
  </section>

  <section data-section="stakes" class="band">
    <div class="container">
      <p class="eyebrow">What is at stake</p>
      <h2>Every day without a site that works is a day customers choose someone else.</h2>
      <div class="grid g2">
        <div class="card outline">
          <h3>Without a site that works</h3>
          <ul class="marks bad">
            <li>Customers pick a competitor who looks more established</li>
            <li>Interested people leave with no way to follow up</li>
            <li>Evenings lost wrestling with tools instead of serving customers</li>
          </ul>
        </div>
        <div class="card outline">
          <h3>With WebGen</h3>
          <ul class="marks good">
            <li>A professional site you are proud to share</li>
            <li>Every sign-up captured and followed up automatically</li>
            <li>Your site, audience and email in one place</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section data-section="responsible" class="dark">
    <div class="container two">
      <div>
        <p class="eyebrow">Responsible email</p>
        <h2>Built to respect the inbox.</h2>
        <p>Every email sent through WebGen goes to people who asked for it, from a sender that is verified, with a working way out.</p>
        <p><a href="/email/">Got an email from us? Here is why →</a></p>
      </div>
      <div class="grid g2">
        <div class="card"><h3>Optional double opt-in</h3><p>Turn it on so subscribers confirm before they get anything.</p></div>
        <div class="card"><h3>Easy unsubscribe</h3><p>An unsubscribe link in every email, honoured right away.</p></div>
        <div class="card"><h3>Verified senders</h3><p>Sending domains are checked before use.</p></div>
        <div class="card"><h3>Suppression lists</h3><p>Bounces and complaints are never mailed again.</p></div>
      </div>
    </div>
  </section>

  <section data-section="learn">
    <div class="container">
      <div class="head-row">
        <div><p class="eyebrow">Learn</p><h2>Guides for every step.</h2></div>
        <a href="/docs/">Browse all docs →</a>
      </div>
      <div class="grid g4">
        {learn.map((l) => (
          <a class="card outline link-card" href={l.href}>
            <span class="eyebrow">{l.tag}</span>
            <h3>{l.title}</h3>
            <p>{l.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section data-section="faq" class="band">
    <div class="container narrow">
      <h2>Questions</h2>
      <details><summary>Do I need to know how to code or design?</summary><p>No. You describe the business and edit by clicking or asking for changes in plain words.</p></details>
      <details><summary>Can I use my own domain?</summary><p>Yes. Connect it from your site's Domain settings. The docs walk through each step.</p></details>
      <details><summary>Who owns my content and contact list?</summary><p>[CONFIRM: ownership and export wording]</p></details>
      <details><summary>I got an email from a WebGen site. Why?</summary><p>Businesses use WebGen to email people who signed up on their site. <a href="/email/">Read how it works and how to unsubscribe.</a></p></details>
    </div>
  </section>

  <section data-section="cta" class="final">
    <div class="container">
      <h2>See your site today.</h2>
      <p>Describe your business. We will build the first version.</p>
      <a class="btn btn-accent" href={EARLY_ACCESS}>Request early access</a>
    </div>
  </section>
</Base>

<script>
  import { initAudienceSwitch } from '../scripts/audience.js';
  initAudienceSwitch(document.body);
</script>

<style is:global>
  main > section { margin-top: 88px; }
  main > section.hero { margin-top: 56px; text-align: center; }
  main > section.band { background: var(--surface); padding: 56px 0; }
  main > section.dark { background: var(--ink); color: var(--on-dark); padding: 56px 0; }
  main > section.dark h2, main > section.dark h3 { color: var(--white); }
  main > section.dark .card { background: transparent; border: 1px solid var(--on-dark-line); }
  main > section.dark .card p { color: var(--on-dark-2); }
  main > section.dark a { color: var(--accent); }
  main > section.dark :focus-visible, main > section.final :focus-visible { outline-color: var(--accent); }
  main > section.final { background: var(--ink); color: var(--on-dark-2); padding: 72px 0; text-align: center; }
  main > section.final h2 { color: var(--white); }
  [hidden] { display: none !important; }

  /* The eyebrow is each section's one accent (blue); the hero h1 keeps the sunflower underline. */
  .eyebrow { font: 700 .8125rem/1.2 var(--font-body); letter-spacing: .08em; text-transform: uppercase; color: var(--link); margin: 0 0 12px; display: block; }
  .link-card .eyebrow { color: var(--muted); }
  .dark .eyebrow { color: var(--on-dark-2); }
  .narrow { max-width: 760px; }
  .lede { max-width: 680px; margin: 0 auto 28px; font-size: 1.1875rem; color: var(--muted); }
  .hero h1 { max-width: 920px; margin: 32px auto 20px; letter-spacing: -.03em; }
  .mark { background: linear-gradient(transparent 60%, var(--accent) 60%); padding: 0 6px; }
  .switch { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; }
  .switch button { min-height: 44px; padding: 0 20px; border: 0; border-radius: 999px; background: transparent; color: var(--ink); font: 600 1rem/1 var(--font-body); cursor: pointer; }
  .switch button[aria-pressed="true"] { background: var(--ink); color: var(--white); }
  .cta-row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px 20px; justify-content: center; list-style: none; padding: 0; margin: 24px 0 0; color: var(--muted); font-size: .9375rem; }

  .grid { display: grid; gap: 20px; margin-top: 32px; }
  .g2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .g3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .g4 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .two { display: grid; gap: 40px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); align-items: center; }
  .two .grid { margin-top: 0; }
  .stack { display: grid; gap: 16px; }
  /* Cards: feature cards are a fill without a border; list and link cards (.outline) are a border without a fill. */
  .card { background: var(--surface); border-radius: 16px; padding: 24px; }
  .band .card { background: var(--white); }
  .card.outline { background: transparent; border: 1px solid var(--line); }
  .band .card.outline { border-color: var(--line-strong); }
  .card h3 { margin-bottom: 8px; }
  .card p:last-child { margin-bottom: 0; }
  .link-card { text-decoration: none; color: var(--body); display: block; transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease; }
  .link-card:hover { color: var(--body); border-color: var(--line-strong); box-shadow: var(--shadow-lift); transform: translateY(-2px); }
  .link-card h3 { color: var(--ink); }
  .link-card:hover h3 { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) {
    .link-card { transition: none; }
    .link-card:hover { transform: none; }
  }
  .steps { list-style: none; padding: 0; }
  .num { font: 800 1.5rem/1 var(--font-heading); color: var(--link); display: block; margin-bottom: 12px; }
  .head-row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: end; }
  .head-row a, .more a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 600; }
  .more { margin: 24px 0 0; }

  /* Bento: one wide light card + the dark sequence card, then three small light cards. */
  .bento { display: grid; gap: 16px; margin-top: 32px; grid-template-columns: minmax(0, 1fr); }
  .bento .card { border-radius: 20px; padding: 28px; }
  .bento .wide, .bento .card-dark { display: flex; flex-direction: column; min-height: 280px; }
  @media (min-width: 720px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bento .wide { grid-column: 1 / -1; }
  }
  @media (min-width: 960px) {
    .bento { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .bento .wide { grid-column: span 2; }
    .bento .card { padding: 32px; }
  }
  .bento .wide h3, .bento .card-dark h3 { font-size: 1.5rem; letter-spacing: -.02em; }
  .bento .wide p { max-width: 440px; }
  /* Wide card: text, then the AI assistant screenshot. From 960px they sit side by side and the
     screenshot is cropped from the right so the assistant panel stays in view. */
  .bento .wide { gap: 24px; }
  .wide-text { display: flex; flex-direction: column; }
  .wide-shot {
    display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 100% 0;
    border: 1px solid var(--line-strong); border-radius: 12px; background: var(--white); box-shadow: var(--shadow-lift);
  }
  @media (min-width: 960px) {
    .bento .wide { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); align-items: stretch; }
    .wide-text { min-height: 100%; }
    .wide-shot { height: 100%; min-height: 240px; aspect-ratio: auto; }
  }
  .card-dark { background: var(--ink); color: var(--on-dark); }
  .card-dark h3 { color: var(--white); }
  .pills, .seq { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .wide .pills { margin-top: auto; padding-top: 24px; }
  .pills li { padding: 6px 14px; background: var(--white); border: 1px solid var(--line); border-radius: 999px; font-size: .9375rem; color: var(--ink); }
  .pills li:last-child { background: var(--tint); border-color: var(--tint); color: var(--link); font-weight: 600; }
  .seq { flex-direction: column; margin-top: 24px; }
  .seq li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 14px; background: var(--ink-raised); border-radius: 10px; color: var(--white); font-size: .9375rem; }
  .seq li span:last-child { color: var(--on-dark); }

  .marks { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .marks li { position: relative; padding-left: 30px; }
  .marks li::before { position: absolute; left: 0; top: 0; font-weight: 800; }
  .marks.bad li::before { content: "\2715"; color: var(--danger); }
  .marks.good li::before { content: "\2713"; color: var(--link); }

  [data-section="faq"] details { border-bottom: 1px solid var(--line-strong); padding: 4px 0; }
  [data-section="faq"] summary { min-height: 44px; display: flex; align-items: center; cursor: pointer; font-weight: 600; color: var(--ink); }
  [data-section="faq"] details p { margin: 0 0 14px; }

  .product .shot { margin: 0 auto; border: 1px solid var(--line-strong); border-radius: 16px; overflow: hidden; background: var(--white); box-shadow: var(--shadow-lift); }
  .shot-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: var(--surface); border-bottom: 1px solid var(--line); }
  .shot-bar i { width: 10px; height: 10px; border-radius: 50%; background: var(--line-strong); }
  /* The real editor screenshot, at its own aspect ratio (width/height attributes reserve the space). */
  .shot-img { display: block; width: 100%; height: auto; }

  /* Built with WebGen: the example site full width, then the two customer slots side by side. */
  .ex-grid { display: grid; gap: 20px; margin-top: 32px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 720px) {
    .ex-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ex-main { grid-column: 1 / -1; }
  }
  .ex-card { background: var(--surface); border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 20px; }
  .ex-text h3 { margin: 0; }
  .ex-text p { margin: 4px 0 0; color: var(--muted); }
  .ex-text .ex-label { margin: 0 0 6px; font: 700 .75rem/1.2 var(--font-body); letter-spacing: .06em; text-transform: uppercase; color: var(--link); }
  .ex-shots { position: relative; padding-bottom: 24px; }
  .ex-desktop { display: block; width: 100%; height: auto; border: 1px solid var(--line-strong); border-radius: 12px; box-shadow: var(--shadow-lift); }
  /* The phone overlaps the desktop shot's bottom-right corner, framed like a handset. */
  .ex-phone {
    position: absolute; right: 4%; bottom: 0; width: 22%; height: auto;
    border: 4px solid var(--ink); border-radius: 18px; background: var(--ink); box-shadow: var(--shadow-lift);
  }
  @media (min-width: 720px) { .ex-phone { border-width: 6px; border-radius: 26px; } }
  .ex-blank { aspect-ratio: 16 / 10; border-radius: 12px; background: var(--tint); border: 1px dashed var(--line-strong); }
</style>
