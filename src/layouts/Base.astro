---
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import OrgJsonLd from '../components/OrgJsonLd.astro';

interface Props { title: string; description: string; path: string; noCanonical?: boolean }
const { title, description, path, noCanonical = false } = Astro.props;
const canonical = `https://webgnr.com${path}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WebGen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <slot name="head" />
    {path === '/' && <OrgJsonLd />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav current={path} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
